{
  "name": "AERO",
  "nodes": [
    {
      "parameters": {
        "url": "     https://aviationweather.gov/api/data/metar?ids=VIDP,VABB,VOBL&format=json",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        704,
        48
      ],
      "id": "3f14ba4d-f0aa-4f2a-b1db-8eac05d27518",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\n\nconst blocks = items.map(m =>\n  `${m.airport}: ${m.flightCategory} | Wind ${m.windKt} kt | Vis ${m.visibility} | Temp ${m.temp}°C | Risk ${m.risk}\\n${m.pilotFlights}`\n);\n\nconst portal = $('Config').first().json.portal;\n\nreturn [{ json: { message: \"✈️ PILOT PRE-FLIGHT BRIEFING\\n\\n\" + blocks.join(\"\\n\\n\") + \"\\n\\n🔗 Portal: \" + portal + \"?role=home\" } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        304
      ],
      "id": "f3521982-7270-4d70-a78f-7940507ed845",
      "name": "Pilot Briefing"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "99f20913-3d60-480e-98d7-dfc87debde91",
              "name": "message",
              "value": "=⚠️ DELAY RISK at {{ $json.airport }}: {{ $json.flightCategory }}, wind {{ $json.windKt }} kt, visibility {{ $json.visibility }}. Alert gates, crew and passenger services.\nNext departures:\n{{ $json.groundFlights }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1552,
        -288
      ],
      "id": "b076755c-91f8-4c4b-9276-c905837cd8c5",
      "name": "Delay Alert"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ede3c37c-17ac-4166-bb78-ee0ceb01a10a",
              "name": "message",
              "value": "=✅ NORMAL OPS at {{ $json.airport }}: {{ $json.flightCategory }}, wind {{ $json.windKt }} kt.\nNext departures:\n{{ $json.groundFlights }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1568,
        112
      ],
      "id": "305f9219-1bca-4230-93e4-eab058d5791e",
      "name": "Normal Ops"
    },
    {
      "parameters": {
        "jsCode": "const portal = $('Config').first().json.portal;\nconst flights = $('Flights Summary').first().json.flights;\n\nconst nowStr = new Date().toLocaleTimeString('en-GB', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit' });\n\nconst next = icao => {\n  const all = flights\n    .filter(f => f.from_icao === icao)\n    .sort((a, b) => a.departure_time.localeCompare(b.departure_time));\n  const upcoming = all.filter(f => f.departure_time >= nowStr);\n  return (upcoming.length ? upcoming : all).slice(0, 2);\n};\n\nconst lines = (list, role) => list\n  .map(f => `• ${f.flight_no} → ${f.to_iata} dep ${f.departure_time}, gate ${f.gate}\\n  ${portal}?role=${role}&flight=${f.flight_no}`)\n  .join('\\n');\n\nreturn $input.all().map(item => {\n  const m = item.json;\n  const wind = m.wspd ?? 0;\n  const cat = m.fltCat || 'UNKNOWN';\n  const risky = ['IFR', 'LIFR'].includes(cat) || wind > 25;\n  const list = next(m.icaoId);\n\n  return {\n    json: {\n      airport: m.icaoId,\n      temp: m.temp,\n      windKt: wind,\n      visibility: m.visib,\n      flightCategory: cat,\n      risk: risky ? 'HIGH' : 'LOW',\n      raw: m.rawOb,\n      pilotFlights: lines(list, 'pilot'),\n      groundFlights: lines(list, 'ground')\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        928,
        48
      ],
      "id": "81f43dc9-66a1-4a80-b90c-b5ab54299623",
      "name": "Risk rating"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 4
          },
          "conditions": [
            {
              "id": "fdc744cf-875b-4d7e-9659-9e2fb89bf4bd",
              "leftValue": "={{ $json.risk }}",
              "rightValue": "HIGH",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
